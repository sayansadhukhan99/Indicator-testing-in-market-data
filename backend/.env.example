# Fyers API credentials (create an app at https://myapi.fyers.in/dashboard)
FYERS_CLIENT_ID=YOUR_APP_ID-100
FYERS_SECRET_KEY=YOUR_SECRET_KEY
# Optional: only needed for POST /api/auth/refresh (15-day refresh-token flow)
FYERS_PIN=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Defaults served to the frontend
FYERS_SYMBOL=NSE:NIFTY50-INDEX
FYERS_RESOLUTION=5
FYERS_RANGE_DAYS=30

# Comma separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
